# Copy to .env. `pnpm dev` creates it for you with local values on first run.
NODE_ENV=development
API_PORT=4000

# MySQL (Docker Compose publishes it on 3307)
DATABASE_URL=mysql://statlume:statlume_local@127.0.0.1:3307/statlume

# Long random strings. `pnpm dev` generates them on first run.
JWT_ACCESS_SECRET=
REFRESH_TOKEN_PEPPER=

# Origin of the web app, used for CORS and the CSRF origin check
WEB_ORIGIN=http://localhost:3000

# Set to true when served over HTTPS
COOKIE_SECURE=false

# Optional: fixed passwords for the two seeded accounts (random if empty)
SEED_ADMIN_PASSWORD=
SEED_VIEWER_PASSWORD=
# Optional: last day of seeded data, YYYY-MM-DD (defaults to today in store time)
SEED_END_DATE=
