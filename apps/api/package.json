{
  "name": "@statlume/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/server.ts",
    "start": "node --env-file-if-exists=.env src/server.ts",
    "db:migrate": "node --env-file-if-exists=.env src/db/migrate.ts",
    "db:setup": "node --env-file-if-exists=.env src/db/setup.ts",
    "seed": "node --env-file-if-exists=.env src/db/seed.ts",
    "typecheck": "tsc -p ."
  },
  "dependencies": {
    "@statlume/shared": "workspace:*",
    "argon2": "^0.45.2",
    "cookie-parser": "^1.4.7",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.24.6",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.0.0"
  }
}
